# Build
/target
# The vendored cloud crate is a `[patch]` source, not a workspace member: its
# own build output and lockfile are not project content (target/ alone is
# 2 GB after one test run).
/vendor/*/target
/vendor/*/Cargo.lock

# Assets (models/images stay local-only; not committed for now)
# (Leading slash + directory: git cannot re-include a path inside an excluded
# directory, so the shader exception below has to un-ignore the parents first.)
/assets/*
# ...except shader sources: they are code, not content, and the game will not
# run without them (a missing shader shows up as an invisible effect, not an
# error).
!/assets/shaders/
# The shader must be `.wesl`: `#import`/`import` are WESL syntax and a `.wgsl`
# file is fed to plain WGSL, which rejects the imports. A stale copy with the
# wrong extension is a trap, not a file.
/assets/shaders/*.wgsl

# Agent/session housekeeping
/.box-agent/
/.box-agent-scratch/
# Per-file chat-retention markers the editor writes next to files it has
# referenced in a conversation (`{"retain_for_chat": true}`). Runtime
# bookkeeping, not project content.
*.artifact.json

# Local-only diagnostics / screenshots
/examples/_stats.rs
/image*.png

# Local save files (player runtime data)
/saves/

# Scratch dir for temporary test output
/.tmp/

# OS
.DS_Store
Thumbs.db
